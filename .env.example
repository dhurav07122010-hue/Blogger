# ==============================================================================
# Blogger AI Agent Configuration
# ==============================================================================
# All AI inference is powered by Google Gemini API.
# NO local LLMs are run, keeping memory footprint lightweight for 8GB RAM systems.
# ==============================================================================

# Gemini API Key (Get free from: https://aistudio.google.com/app/apikey)
# NEVER commit your real key or share it in code!
GEMINI_API_KEY=

# Active Gemini text model: gemini-3.1-flash-lite (fast, high availability, free tier friendly)
# Alternates: gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite
AI_GENERATION_MODE=online
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Web Image Search Settings (AI image generation removed)
IMAGE_SOURCE=web
IMAGE_AUTO_SELECT=true
IMAGE_MIN_RELEVANCE=strict

# Google / Blogger OAuth 2.0 Credentials for Blogger API v3
# Create an OAuth 2.0 Client ID (Web Application) in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/blogger/oauth2callback

# Optional direct aliases for Blogger:
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# Default Blogger Blog ID (Numeric ID from your Blogger dashboard URL)
BLOGGER_BLOG_ID=

# Publishing Safety Controls
# AUTO_PUBLISH is strictly FALSE by default for safety. Even when true, quality gates apply.
AUTO_PUBLISH=false

# Minimum Quality Gate Score required for approval (0 - 100)
QUALITY_THRESHOLD=85

# Enable Demo Mode (true/false) - Works completely offline without API keys!
DEMO_MODE=true

# Internet Research & Search Engine Configuration
# Providers: auto (Google News + Wikipedia - Free tier / Zero key required), serpapi, or tavily
SEARCH_PROVIDER=auto
SERPAPI_API_KEY=
TAVILY_API_KEY=
TRENDS_GEO=IN

# Server configuration
HOST=127.0.0.1
PORT=8000

# DATABASE_URL=sqlite:///./data/blogger_agent.db
